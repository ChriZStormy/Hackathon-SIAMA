# ==============================================================================
# SIAMA-Impute - Variables de entorno de ejemplo
# Copiar a .env y ajustar según el entorno local o de despliegue
# ==============================================================================

# Entorno general
SIAMA_ENV=development
SIAMA_CONFIG_PATH=config/settings.yaml

# Rutas de datos (relativas a la raíz del proyecto o absolutas si se requiere)
SIAMA_DATA_RAW_DIR=data/raw
SIAMA_DATA_PROCESSED_DIR=data/processed
SIAMA_DATA_EXTERNAL_DIR=data/external

# Base de datos PostgreSQL + PostGIS
POSTGRES_USER=siama_user
POSTGRES_PASSWORD=siama_dev_password
POSTGRES_DB=siama_impute
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Frontend demo
VITE_API_BASE_URL=http://localhost:8000
